<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_view_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/SecurityCardMarketplaceCard.ShapeOverlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,0.632"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_out_of_stock_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/security_card_out_of_stock_overlay"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/image_view_card"
        app:layout_constraintEnd_toEndOf="@id/image_view_card"
        app:layout_constraintStart_toStartOf="@id/image_view_card"
        app:layout_constraintTop_toTopOf="@id/image_view_card"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/text_view_card_tag"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:background="@drawable/security_card_tag_background"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:textAppearance="@style/MuunTextAppearance.Body.Md"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/image_view_card"
        app:layout_constraintEnd_toEndOf="@id/image_view_card"
        tools:text="@string/security_cards_marketplace_out_of_stock"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
