<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/view_footer"
            tools:itemCount="3"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_security_cards_marketplace_card">

    </androidx.recyclerview.widget.RecyclerView>

    <com.google.android.material.divider.MaterialDivider
            android:id="@+id/footer_divider"
            android:layout_width="0dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@id/textView_footer_card_cost"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_height="wrap_content" />

    <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textView_footer_card_cost"
            app:layout_constraintBottom_toTopOf="@id/textView_footer_shipping_cost"
            app:layout_constraintStart_toStartOf="@id/textView_footer_shipping_cost"
            app:layout_constraintEnd_toEndOf="@id/textView_footer_shipping_cost"
            android:layout_width="0dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="32sp"
            android:textColor="@color/text_primary_color"
            tools:text="30,000.00 ARS"
            android:gravity="center"
            android:layout_height="wrap_content" />

    <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textView_footer_shipping_cost"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="24dp"
            android:textSize="16sp"
            android:layout_marginHorizontal="16dp"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_secondary_color"
            tools:text="+23,000 ARS shipping &amp; taxes"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

    <View
            android:id="@+id/view_footer"
            android:layout_width="0dp"
            app:layout_constraintTop_toTopOf="@id/footer_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>