<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:muun="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">

        <io.muun.apollo.presentation.ui.view.MuunHeader
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                muun:elevated="false" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textView_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary_color"
                    android:textSize="32sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Provider" />

            <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textView_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="24dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_secondary_color"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textView_title"
                    tools:text="Description." />

            <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageView_card"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintDimensionRatio="H,0.632"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textView_description" />

            <LinearLayout
                    android:id="@+id/specs_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/imageView_card" />

            <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textView_see_full_specs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="24dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/security_cards_card_detail_see_full_specs"
                    android:textColor="@color/blue_buttons"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/specs_container" />

            <Space
                    android:id="@+id/spacer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintBottom_toTopOf="@id/textView_footer_card_cost"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textView_see_full_specs" />

            <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textView_footer_card_cost"
                    app:layout_constraintBottom_toTopOf="@id/textView_footer_shipping_cost"
                    app:layout_constraintStart_toStartOf="@id/textView_footer_shipping_cost"
                    app:layout_constraintEnd_toEndOf="@id/textView_footer_shipping_cost"
                    android:layout_width="0dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="32sp"
                    android:textColor="@color/text_primary_color"
                    tools:text="30,000.00 ARS"
                    android:gravity="start"
                    android:layout_height="wrap_content" />

            <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textView_footer_shipping_cost"
                    app:layout_constraintBottom_toTopOf="@id/button_continue"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="24dp"
                    android:textSize="16sp"
                    android:layout_marginHorizontal="24dp"
                    android:gravity="start"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_secondary_color"
                    tools:text="+23,000 ARS shipping &amp; taxes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content" />

            <View
                    android:id="@+id/view_footer"
                    android:layout_width="0dp"
                    app:layout_constraintTop_toTopOf="@id/textView_footer_card_cost"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/textView_footer_shipping_cost"
                    android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_continue"
                    style="@style/muun_button_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_language"
                    app:iconTint="@color/muun_button_primary_text_color"
                    app:iconGravity="textStart"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="24dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="GO TO PROVIDER" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</LinearLayout>
