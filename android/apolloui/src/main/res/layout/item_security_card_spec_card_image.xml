<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_view_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="H,0.632"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/sc_satochip_1" />

    <!-- Vertical measurement line (left of card) -->
    <View
        android:id="@+id/line_vertical"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginEnd="10dp"
        android:background="@color/text_secondary_color"
        app:layout_constraintBottom_toBottomOf="@id/image_view_card"
        app:layout_constraintEnd_toStartOf="@id/image_view_card"
        app:layout_constraintTop_toTopOf="@id/image_view_card"
        tools:background="#614DFF" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="8dp"
        android:layout_height="5dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrowhead_up"
        app:layout_constraintEnd_toEndOf="@id/line_vertical"
        app:layout_constraintStart_toStartOf="@id/line_vertical"
        app:layout_constraintTop_toTopOf="@id/line_vertical"
        tools:tint="#614DFF" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="8dp"
        android:layout_height="5dp"
        android:contentDescription="@null"
        android:rotation="180"
        android:src="@drawable/ic_arrowhead_up"
        app:layout_constraintBottom_toBottomOf="@id/line_vertical"
        app:layout_constraintEnd_toEndOf="@id/line_vertical"
        app:layout_constraintStart_toStartOf="@id/line_vertical"
        tools:tint="#614DFF" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_view_dim_height"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="@string/security_cards_full_specs_dim_height"
        android:textColor="@color/text_secondary_color"
        android:textSize="12sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@id/image_view_card"
        app:layout_constraintEnd_toStartOf="@id/line_vertical"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/image_view_card" />

    <!-- Horizontal measurement line (below card) -->
    <View
        android:id="@+id/line_horizontal"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/text_secondary_color"
        app:layout_constraintEnd_toEndOf="@id/image_view_card"
        app:layout_constraintStart_toStartOf="@id/image_view_card"
        app:layout_constraintTop_toBottomOf="@id/image_view_card"
        tools:background="#614DFF" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="5dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrowhead_left"
        app:layout_constraintBottom_toBottomOf="@id/line_horizontal"
        app:layout_constraintStart_toStartOf="@id/line_horizontal"
        app:layout_constraintTop_toTopOf="@id/line_horizontal"
        tools:tint="#614DFF" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="5dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        android:rotation="180"
        android:src="@drawable/ic_arrowhead_left"
        app:layout_constraintBottom_toBottomOf="@id/line_horizontal"
        app:layout_constraintEnd_toEndOf="@id/line_horizontal"
        app:layout_constraintTop_toTopOf="@id/line_horizontal"
        tools:tint="#614DFF" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_view_dim_width"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="@string/security_cards_full_specs_dim_width"
        android:textColor="@color/text_secondary_color"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/image_view_card"
        app:layout_constraintStart_toStartOf="@id/image_view_card"
        app:layout_constraintTop_toBottomOf="@id/line_horizontal" />

</androidx.constraintlayout.widget.ConstraintLayout>
