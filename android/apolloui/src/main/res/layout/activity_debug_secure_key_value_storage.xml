<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:muun="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <io.muun.apollo.presentation.ui.view.MuunHeader
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            muun:elevated="true" />

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="@dimen/muun_text_size_body"
                android:textColor="@color/text_secondary_color"
                android:text="Hardcoded alias: libwallet-bridge-smoketest"
                tools:ignore="HardcodedText" />

        <io.muun.apollo.presentation.ui.view.MuunButton
                style="@style/muun_button_primary"
                android:layout_marginTop="16dp"
                android:id="@+id/debug_button_secure_kv_put"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PUT"
                tools:ignore="HardcodedText" />

        <io.muun.apollo.presentation.ui.view.MuunButton
                style="@style/muun_button_primary"
                android:layout_marginTop="8dp"
                android:id="@+id/debug_button_secure_kv_get"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GET"
                tools:ignore="HardcodedText" />

        <io.muun.apollo.presentation.ui.view.MuunButton
                style="@style/muun_button_primary"
                android:layout_marginTop="8dp"
                android:id="@+id/debug_button_secure_kv_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DELETE"
                tools:ignore="HardcodedText" />

        <io.muun.apollo.presentation.ui.view.MuunButton
                style="@style/muun_button_primary"
                android:layout_marginTop="8dp"
                android:id="@+id/debug_button_secure_kv_wipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WIPE"
                tools:ignore="HardcodedText" />

        <io.muun.apollo.presentation.ui.view.MuunButton
                style="@style/muun_button_primary"
                android:layout_marginTop="16dp"
                android:id="@+id/debug_button_export_audit_trail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export audit trail"
                tools:ignore="HardcodedText" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
